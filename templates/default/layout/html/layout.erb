<!DOCTYPE html>
<html lang="en">
  <head>
    <%= erb(:headers) %>
  </head>
  <body class="kward-docs <%= home_page? ? 'kward-home-body' : 'kward-content-body' %>">
    <a href="#main" class="kward-skip-link">Skip to content</a>

    <header class="kward-topbar">
      <a class="kward-brand" href="<%= url_for('index.html') %>">
        <img class="kward-brand-logo" src="<%= url_for('images/kward_logo.png') %>" alt="" aria-hidden="true">
        <span>
          <strong>Kward</strong>
        </span>
      </a>
      <button class="kward-nav-toggle" type="button" aria-expanded="false" aria-controls="kward-primary-nav" aria-label="Toggle navigation menu" onclick="document.body.classList.toggle('kward-nav-open'); this.setAttribute('aria-expanded', document.body.classList.contains('kward-nav-open'))">
        <span class="kward-nav-toggle-bar"></span>
        <span class="kward-nav-toggle-bar"></span>
        <span class="kward-nav-toggle-bar"></span>
        <span class="kward-sr-only">Menu</span>
      </button>
      <nav id="kward-primary-nav" class="kward-topnav" aria-label="Primary navigation">
        <a href="<%= url_for('index.html') %>" class="<%= 'active' if home_page? %>">Home</a>
        <div class="kward-nav-menu <%= 'active' if guide_page? %>">
          <a class="kward-nav-menu-link" href="<%= url_for(guide_overview) %>">Guides</a>
          <button class="kward-nav-menu-button" type="button" aria-label="Expand guides" aria-expanded="false">⌄</button>
          <div class="kward-nav-dropdown">
            <% guide_groups.each do |title, items| %>
              <section>
                <h2><%= h title %></h2>
                <% items.each do |label, link| %>
                  <a href="<%= url_for(link) %>"><%= h label %></a>
                <% end %>
              </section>
            <% end %>
          </div>
        </div>
        <div class="kward-nav-menu <%= 'active' if extension_page? %>">
          <a class="kward-nav-menu-link" href="<%= url_for(extension_overview) %>">Advanced</a>
          <button class="kward-nav-menu-button" type="button" aria-label="Expand advanced guides" aria-expanded="false">⌄</button>
          <div class="kward-nav-dropdown kward-advanced-nav-dropdown">
            <% extension_groups.each do |title, items| %>
              <section>
                <h2><%= h title %></h2>
                <% items.each do |label, link| %>
                  <a href="<%= url_for(link) %>"><%= h label %></a>
                <% end %>
              </section>
            <% end %>
          </div>
        </div>
        <div class="kward-nav-menu <%= 'active' if api_page? %>">
          <a class="kward-nav-menu-link" href="<%= url_for(api_overview) %>">API Docs</a>
          <button class="kward-nav-menu-button" type="button" aria-label="Expand API docs" aria-expanded="false">⌄</button>
          <div class="kward-nav-dropdown kward-api-nav-dropdown">
            <% api_groups.each do |title, items| %>
              <section>
                <h2><%= h title %></h2>
                <% items.each do |label, link| %>
                  <a href="<%= url_for(link) %>"><%= h label %></a>
                <% end %>
              </section>
            <% end %>
          </div>
        </div>
      </nav>
      <% if api_page? %>
        <a class="kward-api-index-link" href="<%= url_for('class_list.html') %>">Search API index</a>
      <% else %>
        <form class="kward-guide-search" role="search">
          <label class="kward-sr-only" for="kward-guide-search-input">Search user guides</label>
          <input id="kward-guide-search-input" type="search" placeholder="Search guides" autocomplete="off" aria-label="Search user guides" aria-controls="kward-guide-search-results">
          <div id="kward-guide-search-results" class="kward-guide-search-results" role="listbox" aria-label="Search results"></div>
        </form>
      <% end %>
      <script type="application/json" id="kward-guide-search-index"><%= guide_search_index_json %></script>
    </header>

    <% if home_page? %>
      <main id="main" class="kward-home">
        <section class="kward-hero">
          <div class="kward-hero-copy">
            <p class="kward-eyebrow">⌘ Ruby CLI Coding Agent</p>
            <h1>
              <span class="kward-swosh" aria-label="Your terminal. Your RPC frontend. Your workflow.">
                <span class="kward-swosh-text kward-swosh-text-a" aria-hidden="true">Your terminal.</span>
                <span class="kward-swosh-text kward-swosh-text-b" aria-hidden="true">Your RPC frontend.</span>
                <span class="kward-swosh-text kward-swosh-text-e" aria-hidden="true">Your workflow.</span>
              </span>
              <br>
              <span class="kward-swosh" aria-label="Your agent. Your LLM engine. Your harness.">
                <span class="kward-swosh-text kward-swosh-text-c" aria-hidden="true">Your agent.</span>
                <span class="kward-swosh-text kward-swosh-text-d" aria-hidden="true">Your LLM engine.</span>
                <span class="kward-swosh-text kward-swosh-text-f" aria-hidden="true">Your harness.</span>
              </span>
            </h1>
            <p class="kward-lede">Kward is a general-purpose coding agent written in Ruby: terminal-native, project-aware, pipeable, and designed around your workflow.</p>
            <div class="kward-actions">
              <a class="kward-primary-button" href="<%= url_for('file.README.html') %>">Get Started ›</a>
              <a class="kward-secondary-button" href="https://github.com/kaiwood/kward" target="_blank" rel="noopener noreferrer">View on GitHub</a>
            </div>
            <p class="kward-supports">Supports <span>OpenAI</span>, <span>Anthropic</span>, <span>OpenRouter</span> &amp; more.</p>
          </div>
          <div class="kward-hero-art" aria-hidden="true">
            <img src="<%= url_for('images/kward_logo.png') %>" alt="">
          </div>
        </section>

        <section id="features" class="kward-feature-strip" aria-label="Feature summary">
          <article><strong>⌘</strong><h2>Project-aware agent loop</h2><p>Inspect, reason, patch, verify.</p></article>
          <article><strong>▤</strong><h2>Unix filter mode</h2><p>Pipe diffs, logs, and code through Kward.</p></article>
          <article><strong>▰</strong><h2>Branchable sessions</h2><p>Resume, rewind, fork, compact, export.</p></article>
          <article><strong>›_</strong><h2>Worker pipelines</h2><p>Queue focused agent tasks from the TUI.</p></article>
          <article><strong>◎</strong><h2>Live source intelligence</h2><p>Search the web and read public repos.</p></article>
          <article><strong>✣</strong><h2>Ruby-native extensions</h2><p>Shape Kward with plugins, skills, and prompts.</p></article>
        </section>

        <section class="kward-install-card">
          <div class="kward-install-copy">
            <h2>⇩ Install</h2>
            <p>Install Kward from RubyGems and get started in seconds.</p>
            <pre><code>gem install kward</code></pre>
            <p>Then initialize the starter pack, if you want the defaults.</p>
            <pre><code>kward init</code></pre>
            <a href="<%= url_for('file.getting-started.html') %>">View full installation docs →</a>
          </div>
          <div class="kward-screen-card">
            <img src="<%= url_for('images/kward_screen_1.png') %>" alt="Kward terminal interface screenshot">
          </div>
        </section>

        <section class="kward-capabilities">
          <h2>⌘ Built for real development loops</h2>
          <ul>
            <li>Inspect, patch, verify, repeat against a real workspace.</li>
            <li>Edit files in Kward’s built-in editor with syntax highlighting, search, undo, and familiar keybindings.</li>
            <li>Review diffs, stage files, and commit changes from the integrated Git workflow.</li>
            <li>Pipe diffs, logs, code, and generated text through Kward as a Unix filter.</li>
            <li>Organize long-running work with tabs, sessions, rewind, forks, compaction, and exports.</li>
            <li>Dispatch worker tasks, leave them running, review the results later.</li>
            <li>Ground answers with live web search and public source repositories before guessing.</li>
            <li>Shape Kward with memory, skills, prompts, personas, and trusted Ruby plugins.</li>
            <li>Build custom UIs on top of Kward’s JSON-RPC backend.</li>
          </ul>
        </section>

        <section class="kward-cta">
          <div>
            <strong>▻</strong>
            <h2>Built for developers. Powered by you.</h2>
            <p>Open source, extensible, and ready for your workflows.</p>
          </div>
          <a class="kward-primary-button" href="https://github.com/kaiwood/kward" target="_blank" rel="noopener noreferrer">View on GitHub</a>
        </section>

        <%= erb(:footer) %>
      </main>
    <% else %>
      <div class="kward-page">
        <main id="main" class="kward-content-page <%= guide_page? ? 'kward-guide-page' : 'kward-api-page' %>">
          <div id="header">
            <%= erb(:breadcrumb) %>
            <%= erb(:search) %>
            <div class="clear"></div>
          </div>

          <div id="content"><%= yieldall %></div>

          <%= erb(:footer) %>
        </main>
      </div>
    <% end %>

    <script type="text/javascript" charset="utf-8" src="<%= url_for('js/kward.js') %>"></script>
  </body>
</html>
