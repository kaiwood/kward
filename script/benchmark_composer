#!/usr/bin/env ruby

require "benchmark"
require "stringio"

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "kward/prompt_interface"

WIDTH = 120
HEIGHT = 30


def prompt_interface
  Kward::PromptInterface.new(input: StringIO.new, output: StringIO.new)
end


def measure(label, iterations:)
  GC.start
  allocated_before = GC.stat(:total_allocated_objects)
  elapsed = Benchmark.realtime { iterations.times { |index| yield(index) } }
  allocated = GC.stat(:total_allocated_objects) - allocated_before
  puts format("%-38s %8.3f ms/op %10.0f alloc/op", label, elapsed * 1_000 / iterations, allocated.fdiv(iterations))
end

puts "Composer benchmark"
puts "Ruby #{RUBY_VERSION} (#{RUBY_PLATFORM})"
puts

prompt = prompt_interface
prompt.send(:replace_input, "Review this change and run its tests.")
measure("short draft layout", iterations: 1_000) do
  prompt.send(:composer_layout, WIDTH, HEIGHT)
end

prompt = prompt_interface
prompt.send(:replace_input, "a" * 10_000)
measure("10,000-character draft layout", iterations: 100) do
  prompt.send(:composer_layout, WIDTH, HEIGHT)
end

prompt = prompt_interface
history = 1_000.times.map { |index| "review component #{index} and explain implementation details with tests" }
prompt.send(:load_history, history)
prompt.send(:replace_input, "no-match-0")
prompt.send(:start_history_search)
measure("1,000-entry changed history query", iterations: 100) do |index|
  prompt.send(:update_history_search_query, "no-match-#{index}")
  prompt.send(:composer_layout, WIDTH, HEIGHT)
end
measure("1,000-entry cached history query", iterations: 1_000) do
  prompt.send(:composer_layout, WIDTH, HEIGHT)
end

prompt = prompt_interface
paths = 50_000.times.map { |index| format("src/path%05d/file%05d.rb", index, index) }
prompt.instance_variable_set(:@file_mention_paths, paths)
prompt.send(:replace_input, "@no-match-0")
measure("50,000-path index build", iterations: 1) do
  prompt.send(:composer_layout, WIDTH, HEIGHT)
end
measure("50,000-path changed file query", iterations: 20) do |index|
  prompt.send(:replace_input, "@no-match-#{index + 1}")
  prompt.send(:composer_layout, WIDTH, HEIGHT)
end
measure("50,000-path cached file query", iterations: 1_000) do
  prompt.send(:composer_layout, WIDTH, HEIGHT)
end
